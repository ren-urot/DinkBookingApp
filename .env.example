# ---------------------------------------------------------------------------
# External booking service configuration
# ---------------------------------------------------------------------------
# Everything here is PUBLIC (it ends up in the browser bundle). Never put secret
# API keys or tokens in a VITE_* variable. If your service needs a secret, put
# it behind a serverless function and point the *_ENDPOINT at that function.

# Which adapter to use for submissions:
#   formspree - Formspree forms (email notifications + submissions dashboard;
#               file uploads require a Formspree plan that supports them)
#   netlify   - Netlify Forms (only when hosted on Netlify; supports file uploads)
#   webhook   - Any HTTPS endpoint you control (serverless function, Google
#               Apps Script, Make/Zapier webhook...). It MUST reply with JSON
#               {"ok": true} (or {"success": true}) only after the data is saved,
#               and must allow CORS from your site. Anything else - including a
#               plain 200 page - is treated as a failure, so customers never see
#               a false "submitted" message.
#   demo      - Local development only. Ignored in production builds.
VITE_SUBMISSION_PROVIDER=formspree

# Endpoint that receives booking requests (JSON for formspree/webhook).
# Formspree example: https://formspree.io/f/abcdwxyz
# Not used for netlify (forms post to /__forms.html automatically).
VITE_BOOKING_ENDPOINT=

# Endpoint that receives payment receipts (multipart/form-data with the file
# in a field named "receipt"). May be a different, access-controlled service.
VITE_RECEIPT_ENDPOINT=

# OPTIONAL - secure booking lookup. Leave empty unless your service can verify
# reference + mobile number server-side and return ONLY that booking's status.
# Expected: POST {reference, mobile} -> 200 {status, court, date, startTime, duration, updatedAt?, note?} | 404
VITE_LOOKUP_ENDPOINT=

# OPTIONAL - shared schedule source. Leave empty to rely on manual conflict
# checking by staff. Expected: GET ?court=<id>&date=YYYY-MM-DD ->
#   200 {"booked":[{"start":"14:00","end":"16:00"}]}
VITE_AVAILABILITY_ENDPOINT=
